# .gitignore
# API keys and secrets
.env
config_mosdac.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
.venv/

# Streamlit
.streamlit/secrets.toml

# Model files (large binaries)
models/*.pkl
models/*.joblib

# Data (don't commit large datasets)
data/sample_images/*.png
data/sample_images/*.jpg
!data/sample_images/.gitkeep

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/

# Build
build/
dist/
*.egg-info/

# Runtime caches (INSAT frame buffer, radar frames, HTTP cache)
data/cache/
data/lightning/*.csv
data/lightning/*.geojson

# Editor / tooling
.claude/
.pytest_cache/

# Natural Earth downloads used only to rebuild the globe texture. The derived
# raster (data/world/earth_texture.png) IS committed; these source files are
# not, so the repository holds no foreign depiction of an Indian boundary.
# tools/build_world_atlas.py re-fetches them on demand.
data/world/*.geojson
data/world/_*.png
