# .env.example
# Copy to .env and fill in what you have. NOTHING here is required to run the
# system: live INSAT imagery, IMD radar and NWP convective parameters all work
# with no credentials at all.
#
# Never commit the real .env - it is already in .gitignore.

# --- Optional: LLM alert phrasing -----------------------------------------
# Free key at https://console.groq.com. Without it the system uses
# deterministic template alerts, which never fail.
# Real Groq keys start with "gsk_".
GROQ_API_KEY=gsk_replace_me
# Override the model if you like. Default: llama-3.3-70b-versatile
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Optional: surface observations ---------------------------------------
# Free tier (1000 calls/day) at https://openweathermap.org/api
# Without it, surface fields fall back to the NWP analysis.
OPENWEATHER_API_KEY=replace_me

# --- Optional: calibrated satellite data ----------------------------------
# Free account at https://mosdac.gov.in/signup (1-2 day approval).
# Gives L1B NetCDF with TRUE brightness temperature in Kelvin, instead of the
# public browse JPEGs whose Kelvin is inferred from the display stretch.
MOSDAC_USERNAME=replace_me
MOSDAC_PASSWORD=replace_me

# If MOSDAC moves its public browse imagery, point this at a current URL.
# MOSDAC_BROWSE_URL=

# --- Optional: lightning network ------------------------------------------
# Blitzortung contributor credentials. Indian networks (IITM/ISRO, ENTLN,
# GLD360) all require institutional access - see REAL_DATA_INTEGRATION.md.
# Alternatively drop a CSV (time,lat,lon[,type]) into data/lightning/ and the
# local archive adapter will pick it up with no credentials at all.
BLITZORTUNG_USER=replace_me
BLITZORTUNG_PASSWORD=replace_me
