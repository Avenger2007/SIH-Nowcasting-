# .env.example
# Copy this to .env and fill in your API keys

# Groq API Key (free at https://console.groq.com)
# Used for LLM-based alert generation
GROQ_API_KEY=groq_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenWeatherMap API Key (free at https://openweathermap.org/api)
# Used for weather data (temperature, humidity, wind, etc.)
OPENWEATHER_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# MOSDAC Credentials (optional, for real satellite data)
# Signup at https://mosdac.gov.in/signup/
MOSDAC_USERNAME=your_mosdac_username
MOSDAC_PASSWORD=your_mosdac_password
